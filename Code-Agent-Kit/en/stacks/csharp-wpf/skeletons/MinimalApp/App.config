<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- sku must agree with TargetFrameworkVersion in the project file. A
         mismatch is not a build error; it changes runtime behaviour. -->
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
